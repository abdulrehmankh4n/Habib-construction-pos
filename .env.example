NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
TZ_NAME=Asia/Karachi
JWT_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=false
INITIAL_ADMIN_PASSWORD=admin123
LOG_LEVEL=info

# Vercel (set in Project → Settings → Environment Variables):
# JWT_SECRET=at least 32 random characters (required on Vercel so login cookies work across instances)
# Link Vercel Blob storage so BLOB_READ_WRITE_TOKEN is set and the SQLite database persists.

HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
