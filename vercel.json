{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --allow-scripts=better-sqlite3,esbuild",
  "buildCommand": "npm run build -w @pos/web && npm run build -w @pos/server",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    {
      "source": "/((?!api/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/better-sqlite3/**"
    }
  }
}
